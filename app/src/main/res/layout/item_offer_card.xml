<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- App Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_offer_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:background="#F1F5F9"
            android:padding="4dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"/>

        <!-- Offer Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_offer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ludo King"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offer_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Install &amp; Register on app"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Badge -->
            <TextView
                android:id="@+id/tv_offer_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Instant Payout"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#E6F8F0"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Reward Coin Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_offer_reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 250"
                android:textColor="#6C13F5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coins"
                android:textColor="#94A3B8"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

