<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="450dp"
            android:orientation="vertical">

            <!-- 1. EMAIL LOGIN SCREEN -->
            <LinearLayout
                android:id="@+id/layoutEmailScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paisa Loots"
                    android:textColor="@color/primary_accent"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Enter your email to login or register"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Email Address"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/rounded_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="name@gmail.com"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray"
                        android:textSize="15sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/primary_button"
                    android:text="Continue with OTP"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. OTP VERIFICATION SCREEN -->
            <LinearLayout
                android:id="@+id/layoutOtpScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify Email"
                    android:textColor="@color/text_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Enter the 6-digit verification code\nsent to your email"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <EditText android:id="@+id/otp1" android:layout_width="45dp" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/rounded_input" android:gravity="center" android:inputType="number" android:maxLength="6" android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp2" android:layout_width="45dp" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/rounded_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp3" android:layout_width="45dp" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/rounded_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp4" android:layout_width="45dp" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/rounded_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp5" android:layout_width="45dp" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/rounded_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
                    <EditText android:id="@+id/otp6" android:layout_width="45dp" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/rounded_input" android:gravity="center" android:inputType="number" android:maxLength="1" android:textColor="@color/text_white" android:textSize="20sp" android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnVerifyOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/primary_button"
                    android:text="Verify OTP"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResendOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Resend OTP in 00:30"
                    android:textColor="@color/primary_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvChangeEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="← Edit Email"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 3. PROFILE COMPLETION SCREEN -->
            <LinearLayout
                android:id="@+id/layoutProfileScreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complete Profile"
                    android:textColor="@color/text_white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Just one last step to get started"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Full Name"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/rounded_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Enter your full name"
                        android:inputType="textPersonName"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Phone Number"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/rounded_input"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91 "
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="10-digit mobile number"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:textColor="@color/text_white"
                        android:textColorHint="@color/text_gray"
                        android:textSize="15sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCompleteProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/primary_button"
                    android:text="Start Earning"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
