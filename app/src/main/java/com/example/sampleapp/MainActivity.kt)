package com.example.sampleapp

import android.os.Bundle
import android.os.CountDownTimer
import android.text.Editable
import android.text.TextWatcher
import android.util.Patterns
import android.view.KeyEvent
import android.view.View
import android.widget.Button
import android.widget.EditText
import android.widget.LinearLayout
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import okhttp3.*
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.RequestBody.Companion.toRequestBody
import org.json.JSONObject
import java.io.IOException

class MainActivity : AppCompatActivity() {

    private val BASE_URL = "https://paisaloots.site/api"
    private val httpClient = OkHttpClient()
    private lateinit var sessionManager: SessionManager

    private lateinit var layoutEmailScreen: LinearLayout
    private lateinit var layoutOtpScreen: LinearLayout
    private lateinit var layoutProfileScreen: LinearLayout
    private lateinit var otpBoxes: Array<EditText>
    private lateinit var timer: CountDownTimer

    private var verifiedEmail = ""

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        sessionManager = SessionManager(this)

        if (sessionManager.isLoggedIn()) {
            openDashboard()
            return
        }

        setContentView(R.layout.activity_main)

        layoutEmailScreen = findViewById(R.id.layoutEmailScreen)
        layoutOtpScreen = findViewById(R.id.layoutOtpScreen)
        layoutProfileScreen = findViewById(R.id.layoutProfileScreen)

        val etEmail = findViewById<EditText>(R.id.etEmail)
        val btnSendOtp = findViewById<Button>(R.id.btnSendOtp)

        val otp1 = findViewById<EditText>(R.id.otp1)
        val otp2 = findViewById<EditText>(R.id.otp2)
        val otp3 = findViewById<EditText>(R.id.otp3)
        val otp4 = findViewById<EditText>(R.id.otp4)
        val otp5 = findViewById<EditText>(R.id.otp5)
        val otp6 = findViewById<EditText>(R.id.otp6)
        val btnVerifyOtp = findViewById<Button>(R.id.btnVerifyOtp)
        val tvResendOtp = findViewById<TextView>(R.id.tvResendOtp)
        val tvChangeEmail = findViewById<TextView>(R.id.tvChangeEmail)

        val etFullName = findViewById<EditText>(R.id.etFullName)
        val etPhone = findViewById<EditText>(R.id.etPhone)
        val btnCompleteProfile = findViewById<Button>(R.id.btnCompleteProfile)

        otpBoxes = arrayOf(otp1, otp2, otp3, otp4, otp5, otp6)
        setupOtpInputListeners()

        // 1. Send OTP
        btnSendOtp.setOnClickListener {
            val email = etEmail.text.toString().trim()
            if (!Patterns.EMAIL_ADDRESS.matcher(email).matches()) {
                Toast.makeText(this, "Enter a valid email address", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            verifiedEmail = email
            sendOtpApi(email, tvResendOtp)
        }

        // 2. Verify OTP
        btnVerifyOtp.setOnClickListener {
            val enteredOtp = otpBoxes.joinToString("") { it.text.toString().trim() }
            if (enteredOtp.length != 6) {
                Toast.makeText(this, "Enter 6-digit OTP", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            verifyOtpApi(verifiedEmail, enteredOtp)
        }

        // 3. Resend OTP
        tvResendOtp.setOnClickListener {
            if (tvResendOtp.text.toString() == "Resend OTP") {
                sendOtpApi(verifiedEmail, tvResendOtp)
            }
        }

        // 4. Change Email
        tvChangeEmail.setOnClickListener {
            layoutOtpScreen.visibility = View.GONE
            layoutEmailScreen.visibility = View.VISIBLE
            if (::timer.isInitialized) timer.cancel()
        }

        // 5. Complete Profile Action (New User)
        btnCompleteProfile.setOnClickListener {
            val name = etFullName.text.toString().trim()
            val phone = etPhone.text.toString().trim()

            if (name.length < 3) {
                Toast.makeText(this, "Enter full name", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            if (phone.length != 10) {
                Toast.makeText(this, "Enter valid 10-digit mobile number", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }

            completeProfileApi(verifiedEmail, name, phone)
        }
    }

    private fun openDashboard() {
        val userName = sessionManager.getUserName()
        val userRole = sessionManager.getUserRole()
        Toast.makeText(this, "Logged In: $userName ($userRole)", Toast.LENGTH_LONG).show()
    }

    private fun sendOtpApi(email: String, tvResend: TextView) {
        val json = JSONObject().apply { put("email", email) }
        val body = json.toString().toRequestBody("application/json".toMediaType())
        val request = Request.Builder().url("$BASE_URL/send_otp.php").post(body).build()

        httpClient.newCall(request).enqueue(object : Callback {
            override fun onFailure(call: Call, e: IOException) {
                runOnUiThread { Toast.makeText(applicationContext, "Network error", Toast.LENGTH_SHORT).show() }
            }

            override fun onResponse(call: Call, response: Response) {
                runOnUiThread {
                    if (response.isSuccessful) {
                        layoutEmailScreen.visibility = View.GONE
                        layoutOtpScreen.visibility = View.VISIBLE
                        startResendTimer(tvResend)
                        Toast.makeText(applicationContext, "OTP sent to $email", Toast.LENGTH_LONG).show()
                    } else {
                        Toast.makeText(applicationContext, "Failed to send OTP", Toast.LENGTH_SHORT).show()
                    }
                }
            }
        })
    }

    private fun verifyOtpApi(email: String, otp: String) {
        val json = JSONObject().apply {
            put("email", email)
            put("otp", otp)
        }
        val body = json.toString().toRequestBody("application/json".toMediaType())
        val request = Request.Builder().url("$BASE_URL/verify_otp.php").post(body).build()

        httpClient.newCall(request).enqueue(object : Callback {
            override fun onFailure(call: Call, e: IOException) {
                runOnUiThread { Toast.makeText(applicationContext, "Verification failed", Toast.LENGTH_SHORT).show() }
            }

            override fun onResponse(call: Call, response: Response) {
                val resBody = response.body?.string() ?: ""
                runOnUiThread {
                    if (response.isSuccessful) {
                        if (::timer.isInitialized) timer.cancel()
                        val jsonRes = JSONObject(resBody)
                        val isNewUser = jsonRes.optBoolean("is_new_user", true)

                        if (isNewUser) {
                            layoutOtpScreen.visibility = View.GONE
                            layoutProfileScreen.visibility = View.VISIBLE
                        } else {
                            val token = jsonRes.optString("token", "")
                            val role = jsonRes.optString("role", "user")
                            val userObj = jsonRes.optJSONObject("user")
                            val name = userObj?.optString("name", "User") ?: "User"

                            sessionManager.saveUserSession(token, email, name, role)
                            openDashboard()
                        }
                    } else {
                        Toast.makeText(applicationContext, "Invalid or Expired OTP", Toast.LENGTH_SHORT).show()
                    }
                }
            }
        })
    }

    private fun completeProfileApi(email: String, name: String, phone: String) {
        val json = JSONObject().apply {
            put("email", email)
            put("full_name", name)
            put("phone", phone)
        }
        val body = json.toString().toRequestBody("application/json".toMediaType())
        val request = Request.Builder().url("$BASE_URL/complete_profile.php").post(body).build()

        httpClient.newCall(request).enqueue(object : Callback {
            override fun onFailure(call: Call, e: IOException) {
                runOnUiThread { Toast.makeText(applicationContext, "Network error", Toast.LENGTH_SHORT).show() }
            }

            override fun onResponse(call: Call, response: Response) {
                val resBody = response.body?.string() ?: ""
                runOnUiThread {
                    if (response.isSuccessful) {
                        val jsonRes = JSONObject(resBody)
                        val token = jsonRes.optString("token", "")

                        sessionManager.saveUserSession(token, email, name, "user")
                        openDashboard()
                    } else {
                        Toast.makeText(applicationContext, "Failed to complete profile", Toast.LENGTH_SHORT).show()
                    }
                }
            }
        })
    }

    private fun setupOtpInputListeners() {
        for (i in otpBoxes.indices) {
            val currentBox = otpBoxes[i]
            currentBox.addTextChangedListener(object : TextWatcher {
                override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
                override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
                override fun afterTextChanged(s: Editable?) {
                    val text = s?.toString() ?: ""
                    if (text.length > 1) {
                        val digits = text.filter { it.isDigit() }
                        for (j in 0 until minOf(digits.length, otpBoxes.size)) {
                            otpBoxes[j].removeTextChangedListener(this)
                            otpBoxes[j].setText(digits[j].toString())
                            otpBoxes[j].addTextChangedListener(this)
                        }
                        val target = minOf(digits.length - 1, otpBoxes.size - 1)
                        otpBoxes[target].requestFocus()
                        return
                    }
                    if (text.length == 1 && i < otpBoxes.size - 1) {
                        otpBoxes[i + 1].requestFocus()
                    }
                }
            })

            currentBox.setOnKeyListener { _, keyCode, event ->
                if (event.action == KeyEvent.ACTION_DOWN && keyCode == KeyEvent.KEYCODE_DEL) {
                    if (currentBox.text.isEmpty() && i > 0) {
                        otpBoxes[i - 1].requestFocus()
                        otpBoxes[i - 1].setText("")
                        return@setOnKeyListener true
                    }
                }
                false
            }
        }
    }

    private fun startResendTimer(tvResend: TextView) {
        if (::timer.isInitialized) timer.cancel()
        timer = object : CountDownTimer(30000, 1000) {
            override fun onTick(millis: Long) {
                val sec = millis / 1000
                tvResend.text = "Resend OTP in 00:${if (sec < 10) "0$sec" else "$sec"}"
                tvResend.isClickable = false
            }
            override fun onFinish() {
                tvResend.text = "Resend OTP"
                tvResend.isClickable = true
            }
        }.start()
    }
}
